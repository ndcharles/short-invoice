{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "short-invoice",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",

  // The UI is a static Next.js export (`out/`). Static files are served
  // without running the Worker, which is free and does not count toward the
  // 100k requests/day free-plan limit. The Worker runs first for the API,
  // `/s/*` short links and `/` (root redirect on short domains), and runs for
  // any path with no matching file ("none" below), which is how
  // `<short domain>/<alias>` reaches it. It serves the app's 404 page itself.
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/s/*", "/"]
  },

  // All persistent state lives in D1 (created in WEUR, closest region to
  // Lagos). No KV: its free tier allows only 1,000 writes/day and changes
  // take up to 60s to propagate.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "short-invoice",
      "database_id": "9abe67c0-db3b-402f-80dc-fa0e2557a953",
      "migrations_dir": "migrations"
    }
  ],

  "observability": { "enabled": true }
}
