# Security headers for the static app (Workers Static Assets applies this file).
# 'unsafe-inline' scripts are needed by the Next.js static export's inline
# bootstrap; everything else is locked to this origin. img-src allows https:
# for link-preview images fetched from destination sites.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
