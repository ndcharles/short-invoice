{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "short-invoice",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",

  // The UI is a static Next.js export (`out/`). Only API and short-link paths
  // run the Worker; everything else is served as a static asset, which is
  // free and does not count toward the 100k requests/day free-plan limit.
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/s/*"]
  },

  // All persistent state lives in D1 (created in WEUR, closest region to
  // Lagos). No KV: its free tier allows only 1,000 writes/day and changes
  // take up to 60s to propagate.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "short-invoice",
      "database_id": "9abe67c0-db3b-402f-80dc-fa0e2557a953",
      "migrations_dir": "migrations"
    }
  ],

  "observability": { "enabled": true }
}
