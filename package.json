{
  "name": "short-invoice",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n worker,ui -c yellow,cyan \"wrangler dev --port 8787\" \"next dev\"",
    "build": "next build",
    "typecheck": "tsc --noEmit && tsc -p worker/tsconfig.json",
    "lint": "eslint",
    "preview": "next build && wrangler dev",
    "deploy": "next build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply short-invoice --local",
    "db:migrate": "wrangler d1 migrations apply short-invoice --remote",
    "db:seed:local": "wrangler d1 execute short-invoice --local --file=seed/demo.sql && wrangler d1 execute short-invoice --local --file=seed/demo-invoices.sql",
    "tail": "wrangler tail",
    "setup-code": "node scripts/setup-code.mjs",
    "test": "vitest run --project unit --project api",
    "test:unit": "vitest run --project unit",
    "test:api": "vitest run --project api",
    "test:e2e": "vitest run --project e2e",
    "test:all": "vitest run"
  },
  "dependencies": {
    "basecoat-css": "^1.0.2",
    "hono": "^4.13.13",
    "html2canvas-pro": "2.4.5",
    "nanoid": "^6.0.1",
    "next": "16.3.5",
    "pdf-lib": "1.17.1",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261005.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "playwright-core": "1.62.0",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20261001.1": true
  }
}
