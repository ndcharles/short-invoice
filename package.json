{
  "name": "short-invoice",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n worker,ui -c yellow,cyan \"wrangler dev --port 8787\" \"next dev\"",
    "build": "next build",
    "typecheck": "tsc --noEmit && tsc -p worker/tsconfig.json",
    "lint": "eslint",
    "preview": "next build && wrangler dev",
    "deploy": "next build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply short-invoice --local",
    "db:migrate": "wrangler d1 migrations apply short-invoice --remote",
    "db:seed:local": "wrangler d1 execute short-invoice --local --file=seed/demo.sql",
    "tail": "wrangler tail",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:api": "vitest run --project api",
    "db:demo:invoices:local": "wrangler d1 execute short-invoice --local --file=seed/demo-invoices.sql",
    "db:demo:invoices": "wrangler d1 execute short-invoice --remote --file=seed/demo-invoices.sql",
    "db:demo:invoices:clean:local": "wrangler d1 execute short-invoice --local --file=seed/demo-invoices-clean.sql",
    "db:demo:invoices:clean": "wrangler d1 execute short-invoice --remote --file=seed/demo-invoices-clean.sql"
  },
  "dependencies": {
    "basecoat-css": "^1.0.2",
    "hono": "^4.13.13",
    "nanoid": "^6.0.1",
    "next": "16.3.5",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261005.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20261001.1": true
  }
}
